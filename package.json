{
  "name": "dsh-turn-status-phrases",
  "version": "0.1.0",
  "description": "让 DSH turnStatus 显示不断变化的自定义轮次状态短语",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "cordis", "turn-status", "status-phrases", "web-plugin"],
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./phrases": "./lib/phrases.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "peerDependencies": { "@deepseek-ai/dsh-client-runtime": "*", "@deepseek-ai/dsh-client-ui-slots": "*", "@deepseek-ai/dsh-client-locale": "*", "react": "^18.2.0" },
  "scripts": { "build": "node scripts/build-client.mjs", "test": "npm run build && node --test" }
}
